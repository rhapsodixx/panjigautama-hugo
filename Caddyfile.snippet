# Merge into the host Caddyfile (TLS already handled by host Caddy).
# Host Caddy must share Docker network `web` with the blog container
# (same pattern as Vaultwarden: reverse_proxy <container>:port).
# Both apex and alias domains serve the same Hugo container (multi-domain option A).
# Canonical Hugo baseURL remains https://panjigautama.com
panjigautama.com, www.panjigautama.com, blog.kamisamanosumopod.my.id {
	encode gzip
	reverse_proxy panjigautama-hugo:8080
}
